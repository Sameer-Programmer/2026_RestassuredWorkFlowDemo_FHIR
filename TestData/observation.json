{
  "resourceType": "Observation",
  "status": "{{status}}",
  "code": {
    "coding": [
      {
        "system": "{{codingSystem}}",
        "code": "{{codingCode}}",
        "display": "{{codingDisplay}}"
      }
    ]
  },
  "valueQuantity": {
    "value": {{value}},
    "unit": "{{unit}}",
    "system": "{{quantitySystem}}",
    "code": "{{quantityCode}}"
  },
  "subject": {
    "reference": "Patient/{{patientId}}"
  },
  "effectiveDateTime": "{{effectiveDate}}",
  "note": [
    {
      "text": "{{note}}"
    }
  ]
}
