{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "FHIR Observation API resource",
  "type": "object",
  "required": [
    "resourceType",
    "status",
    "code",
    "subject",
    "effectiveDateTime",
    "valueQuantity"
  ],
  "properties": {
    "resourceType": {
      "const": "Observation"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "meta": {
      "type": "object"
    },
    "status": {
      "type": "string",
      "enum": [
        "registered",
        "preliminary",
        "final",
        "amended",
        "corrected",
        "cancelled",
        "entered-in-error",
        "unknown"
      ]
    },
    "code": {
      "type": "object",
      "required": [
        "coding"
      ],
      "properties": {
        "coding": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "system",
              "code",
              "display"
            ],
            "properties": {
              "system": {
                "type": "string",
                "format": "uri"
              },
              "code": {
                "type": "string",
                "minLength": 1
              },
              "display": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": true
    },
    "subject": {
      "type": "object",
      "required": [
        "reference"
      ],
      "properties": {
        "reference": {
          "type": "string",
          "pattern": "^Patient/.+"
        }
      },
      "additionalProperties": true
    },
    "effectiveDateTime": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}(T.*)?$"
    },
    "valueQuantity": {
      "type": "object",
      "required": [
        "value",
        "unit",
        "system",
        "code"
      ],
      "properties": {
        "value": {
          "type": "number"
        },
        "unit": {
          "type": "string",
          "minLength": 1
        },
        "system": {
          "type": "string",
          "format": "uri"
        },
        "code": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": true
    },
    "note": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "text"
        ],
        "properties": {
          "text": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
